:220px;display:grid;place-items:center;background:linear-gradient(145deg,#e7bdbb,#fff0d9 45%,#bdabb5);border:12px solid #fff;box-shadow:0 3px 15px #0002;position:relative;overflow:hidden}.photo:before{content:'✿';font-size:9rem;color:#c1809080;position:absolute;transform:rotate(-20deg)}.photo span{z-index:1;background:#fffbf1d9;padding:7px 12px;font-family:'Cormorant Garamond',serif;font-size:1.6rem}.album-controls{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:20px}.arrow{background:transparent;border:1px solid #b9a59b;border-radius:50%;width:42px;height:42px;color:#6e5352;font-size:1.3rem}.envelopes{display:flex;justify-content:center;gap:15px;flex-wrap:wrap;margin:35px 0}.small-envelope{width:90px;height:66px;background:#e8c8c0;clip-path:polygon(0 0,50% 48%,100% 0,100% 100%,0 100%);border:0;box-shadow:0 4px 10px #0002;transition:transform .3s}.small-envelope:hover,.small-envelope.active{transform:translateY(-10px)}.letter-panel{background:#fffbf2;border:1px solid #d7bdad;box-shadow:0 14px 40px #624b3b18;padding:32px 24px;max-width:570px;margin:25px auto;min-height:250px}.stars{position:absolute;inset:0;overflow:hidden;pointer-events:none}.star{position:absolute;width:2px;height:2px;border-radius:50%;background:#fff2d3;box-shadow:0 0 9px #fff8d9;animation:twinkle 3s ease-in-out infinite alternate}@keyframes twinkle{from{opacity:.2;transform:scale(.5)}to{opacity:1;transform:scale(1.6)}}.moon{width:110px;height:110px;border-radius:50%;background:#f9e6bf;box-shadow:0 0 40px #e9d5ad77,0 0 100px #e9d5ad30;margin:30px auto;position:relative}.moon:after{content:'';position:absolute;inset:-7px 0 7px 30px;background:#243251;border-radius:50%}.star-buttons{display:flex;justify-content:center;gap:13px;flex-wrap:wrap;margin:25px auto}.star-button{border:0;background:none;color:#f6dfae;font-size:2rem;text-shadow:0 0 16px #ffe9ac;transition:transform .3s}.star-button:hover,.star-button.active{transform:scale(1.45)}.clock{width:220px;height:220